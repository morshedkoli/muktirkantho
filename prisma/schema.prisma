generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  draft
  published
}

model Post {
  id              String     @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  slug            String     @unique
  /// Slugs this post used to live at.
  ///
  /// The slug is derived from the title, so editing a headline moves the
  /// article's URL. Without this, every link already published to that URL —
  /// Facebook posts, search results, someone's bookmark — would start 404ing.
  /// The article route looks here and answers an old slug with a 308 to the
  /// current one.
  slugHistory     String[]   @default([])
  excerpt         String
  content         String
  imageUrl        String?
  imagePublicId   String?
  categoryId      String     @db.ObjectId
  districtId      String     @db.ObjectId
  upazilaId       String?    @db.ObjectId
  tags            String[]
  author          String
  youtubeUrl      String?
  metaTitle       String
  metaDescription String
  featured        Boolean    @default(false)
  status          PostStatus @default(draft)
  publishedAt     DateTime?
  viewCount       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  upazila  Upazila? @relation(fields: [upazilaId], references: [id])

  socialShares SocialShare[]
  dailyStats   DailyPostStat[]

  @@index([categoryId])
  @@index([districtId])
  @@index([tags])
  @@index([publishedAt])
  @@index([status, publishedAt])
  /// Old-slug lookups happen on every request that arrives at a stale URL.
  @@index([slugHistory])
}

enum SocialPlatform {
  facebook
}

enum ShareStatus {
  pending
  shared
  failed
}

/// One row per (post, platform) — the record of whether a post ever reached
/// that network, and the reason if it did not.
///
/// The `@@unique([postId, platform])` constraint is the feature, not an
/// optimisation: auto-post runs on every save of a published post, and without
/// a uniqueness guarantee re-saving an article would post it to the page again.
/// The share pipeline claims this row first and only then calls the Graph API.
model SocialShare {
  id       String         @id @default(auto()) @map("_id") @db.ObjectId
  postId   String         @db.ObjectId
  post     Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform SocialPlatform @default(facebook)
  status   ShareStatus    @default(pending)

  /// Graph API id of the created post, and the permalink built from it.
  externalId  String?
  externalUrl String?

  /// Last failure, kept verbatim so an editor can act on it (an expired token
  /// reads very differently from a rejected image URL).
  error       String?
  /// What asked for this share: "auto", "manual" or "retry".
  trigger     String?
  attempts    Int       @default(0)
  lastAttemptAt DateTime?
  sharedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([postId, platform])
  @@index([status])
  @@index([createdAt])
}

/// One row per calendar day of site traffic.
///
/// A daily aggregate rather than a row per hit: a regional news site takes
/// enough traffic that per-view rows grow without bound and need pruning, and
/// nothing on the analytics screen asks a question these counters cannot
/// answer. The cost is that individual visits are not replayable — there is no
/// per-visitor history here, by design.
///
/// Every counter here is bucketed by *UTC* day, which is what `dayKey()`
/// produces. The report reads them back in UTC too, so a day's numbers always
/// mean the same 24 hours regardless of where the server runs.
model DailyStat {
  id   String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Midnight UTC of the day being counted.
  day  DateTime @unique

  /// Any tracked page view, article or not.
  pageViews Int @default(0)
  /// Views that were an article being read.
  postReads Int @default(0)
  /// Distinct visitors, counted once per day by their visitor cookie.
  visitors  Int @default(0)
  /// Of those, the ones that arrived without a visitor cookie at all — a first
  /// visit rather than a return. `visitors - newVisitors` is the returning half.
  newVisitors Int @default(0)

  /// Device split of the day's page views, from the user agent. Three counters
  /// rather than a related table: the set is closed and never grows.
  mobileViews  Int @default(0)
  tabletViews  Int @default(0)
  desktopViews Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // No @@index([day]) — `@unique` above already builds that index, and
  // declaring it twice is a schema error.
}

/// Daily reads per article — what `Post.viewCount` cannot tell you.
///
/// The lifetime counter on the post answers "most read ever", which after a
/// year is a list of last year's stories. This answers "most read *this week*",
/// which is the question a newsroom actually acts on.
model DailyPostStat {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Midnight UTC, same key as DailyStat.
  day    DateTime
  postId String   @db.ObjectId
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reads  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, postId])
  @@index([day])
  @@index([postId])
}

/// Daily views per path — the "top pages" list, articles and listings alike.
///
/// Cardinality is bounded by the routes that exist, not by traffic: the beacon
/// rejects anything that is not a plain public path before it reaches here.
model DailyPathStat {
  id    String   @id @default(auto()) @map("_id") @db.ObjectId
  day   DateTime
  path  String
  views Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, path])
  @@index([day])
}

/// Daily views per acquisition source, derived from the referrer.
///
/// Only *off-site* arrivals are recorded, plus `direct` for a view with no
/// referrer at all. A reader clicking through from one article to the next is
/// not a new source, and counting it as one would drown the real referrers.
model DailyReferrerStat {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  day    DateTime
  /// A known network's display name ("Facebook", "Google") or the bare
  /// hostname, or the literal `direct`.
  source String
  views  Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([day, source])
  @@index([day])
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

}

model District {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  divisionId String?   @db.ObjectId
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  posts     Post[]
  upazilas  Upazila[]
  
  division Division? @relation(fields: [divisionId], references: [id])
   
   @@index([divisionId])
}

model Division {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  districts District[]
}

model Upazila {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String
  districtId String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  district District @relation(fields: [districtId], references: [id])
  posts    Post[]

  @@unique([districtId, slug])
  @@index([districtId])
  @@index([slug])
}

model SiteSetting {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("global")
  logoUrl         String?
  logoPublicId    String?
  iconUrl         String?
  iconPublicId    String?
  faviconUrl      String?
  faviconPublicId String?
  // Logo display height in pixels for the desktop masthead. Mobile auto-scales (~75%).
  logoHeight      Int?     @default(48)
  contactAddress  String?
  contactPhone    String?
  contactEmail    String?
  adminName       String?
  adminEmail      String?
  adminPhone      String?
  adminPasswordHash String?
  // Ads Global Setting
  adsEnabled      Boolean  @default(true)
  // Facebook App Credentials (can be set from admin)
  facebookAppId         String?
  facebookAppSecret     String?
  // Facebook Integration Settings
  facebookPageId        String?
  facebookPageAccessToken String?
  facebookPageName      String?
  facebookAutoPost      Boolean  @default(false)
  facebookConnected     Boolean  @default(false)
  facebookConnectedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MenuItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  label       String
  url         String
  location    String   // "header", "footer", "footer_bottom", "social"
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  openInNewTab Boolean @default(false)
  icon        String?  // platform name for social links
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([location, isActive, order])
}

model Ad {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  placement     String
  imageUrl      String
  imagePublicId String
  targetUrl     String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([placement, isActive, createdAt])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  author    String
  content   String
  status    String   // "pending", "approved", "spam"
  article   String
  sentiment String   // "positive", "negative", "neutral", "spam"
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  role      String   // "Super Admin", "Editor", "Reporter", "Contributor"
  status    String   // "active", "inactive"
  articles  Int      @default(0)
  lastActive String
  avatar    String
  createdAt DateTime @default(now())
}
